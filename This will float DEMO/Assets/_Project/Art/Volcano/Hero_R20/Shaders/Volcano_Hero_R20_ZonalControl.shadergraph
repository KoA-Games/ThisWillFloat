{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3ef976c5ecfc45ff8659981ab75945bc",
    "m_Group": {
        "m_Id": "579d8a8d5cdd454d8afb2b9cb503a198"
    },
    "m_Name": "NormalizeMasks (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1060.0,
            "y": 80.0,
            "width": 300.0,
            "height": 260.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a02e63ad5a4742ccaf528437fcb831e4"
        },
        {
            "m_Id": "3bf282357f0f40b195a3acad843d31de"
        },
        {
            "m_Id": "e7e0590aac404072a9a091e2fa723a1a"
        },
        {
            "m_Id": "7605a138e1ad43efab2c96d3b592d7a7"
        },
        {
            "m_Id": "78e340b74459466bbeb2eb6e358d8f5b"
        },
        {
            "m_Id": "e51629f187094348a78e50b4445f88c8"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "NormalizeMasks",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 weighted = max(ControlRGBA, 0.0) * float4(RockWeight, VegetationWeight, SoilWeight, SummitWeight);\nfloat sum = max(weighted.r + weighted.g + weighted.b + weighted.a, 0.0001);\nNormalizedMasks = weighted / sum;"
}

{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3f2d55ad43a840ebb5c43dbaf8556d64",
    "m_Group": {
        "m_Id": "51242b60f68a4362a42f2dc50860f0a2"
    },
    "m_Name": "PreserveAlbedoDetail (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 880.0,
            "y": 510.0,
            "width": 300.0,
            "height": 260.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "36cc6cfe8e864824a430c4307b672c34"
        },
        {
            "m_Id": "333075847150447e940ade866bba3e80"
        },
        {
            "m_Id": "9ef4957258224f8489b3b828632e1858"
        },
        {
            "m_Id": "5f4cf327ba004e24b21f851bf6c028bb"
        },
        {
            "m_Id": "578555d153d34038a4a1be3bcd84e367"
        },
        {
            "m_Id": "67c975c3e93946aebec9ce994393e647"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "PreserveAlbedoDetail",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float luminance = dot(max(BaseMap.rgb, 0.0), float3(0.2126, 0.7152, 0.0722));\nfloat adjusted = max((luminance - 0.5) * DetailContrast + 0.5, 0.0);\nfloat detailMultiplier = lerp(1.0, adjusted * 2.0, saturate(DetailStrength));\nfloat3 reconstructedColor = max(ZoneColor * detailMultiplier, 0.0);\nFinalBaseColor = max(lerp(max(BaseMap.rgb, 0.0), reconstructedColor, saturate(RecolorStrength)), 0.0);"
}

