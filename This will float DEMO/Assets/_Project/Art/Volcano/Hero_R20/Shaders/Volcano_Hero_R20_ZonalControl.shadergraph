    },
    "m_SourceType": 1,
    "m_FunctionName": "ApplyNormalStrength",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float s = max(Strength, 0.0);\nOut = normalize(float3(In.xy * s, lerp(1.0, In.z, saturate(s))));"
}

